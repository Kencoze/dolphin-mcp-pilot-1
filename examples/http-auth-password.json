{
  "description": "HTTP mode with username/password authentication (MCP 2.0 stateless)",
  "mcpServers": {
    "dolphinscheduler": {
      "type": "streamable-http",
      "url": "http://your-server:8001/mcp/",
      "headers": {
        "X-DS-User": "your_username",
        "X-DS-Password": "your_password"
      }
    }
  }
}
