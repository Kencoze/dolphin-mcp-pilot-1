{
  "description": "HTTP mode with username/password authentication (fallback)",
  "mcpServers": {
    "dolphinscheduler": {
      "type": "sse",
      "url": "http://your-server:8001/mcp/",
      "headers": {
        "X-DS-User": "your_username",
        "X-DS-Password": "your_password"
      }
    }
  }
}
